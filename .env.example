# ─────────────────────────────────────────────────────────────────────────────
# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# Nigdy nie commituj .env.local do repozytorium.
# ─────────────────────────────────────────────────────────────────────────────

# Resend – wysyłanie e-maili z formularza
# Klucz API z https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx

# Adres e-mail, na który trafiają leady
CONTACT_EMAIL=twoj@email.pl

# Adres nadawcy w Resend (musi być zweryfikowany)
FROM_EMAIL=lead@twojadomena.pl

# Publiczny URL strony (bez trailing slash)
# Używany przez formularz i OpenGraph
NEXT_PUBLIC_SITE_URL=https://twojadomena.pl

# Numer telefonu dostępny po stronie klienta (opcjonalne, do dynamicznych komponentów)
NEXT_PUBLIC_PHONE=+48000000000
NEXT_PUBLIC_PHONE_DISPLAY=000 000 000
